@* STAND-IN for the shared sign-in area's Access denied page. *@
@{
    ViewData["Title"] = "Access denied";
}
<div class="card custom-card mx-auto" style="max-width: 38rem;">
    <div class="card-body text-center py-5">
        <span class="avatar avatar-lg avatar-rounded bg-warning-transparent mb-3"><i class="ri-shield-keyhole-line" aria-hidden="true"></i></span>
        <h1 class="page-title mb-2">Access denied</h1>
        <p class="text-muted mb-4">Your account doesn't have access to the Provider area. Patient monitoring data is only shown to the clinicians caring for those patients.</p>
        <p class="fs-13 text-muted mb-0">Demo: switch to a provider account from the profile menu in the top right.</p>
    </div>
</div>
