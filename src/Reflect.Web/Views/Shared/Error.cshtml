@* STAND-IN error page. *@
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="card custom-card mx-auto" style="max-width: 36rem;">
    <div class="card-body text-center py-5">
        <span class="avatar avatar-lg avatar-rounded bg-danger-transparent mb-3"><i class="ri-error-warning-line" aria-hidden="true"></i></span>
        <h1 class="page-title mb-2">Something went wrong</h1>
        <p class="text-muted mb-4">The page couldn't be loaded. Try again, or go back to the dashboard.</p>
        <a href="/" class="btn btn-primary"><i class="ri-home-4-line me-1" aria-hidden="true"></i>Back to dashboard</a>
    </div>
</div>
