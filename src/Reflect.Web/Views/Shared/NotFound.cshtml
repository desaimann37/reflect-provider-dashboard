@* STAND-IN for the real app's standard not-found page. *@
@{
    ViewData["Title"] = "Not found";
}
<div class="card custom-card mx-auto" style="max-width: 36rem;">
    <div class="card-body text-center py-5">
        <span class="avatar avatar-lg avatar-rounded bg-info-transparent mb-3"><i class="ri-search-line" aria-hidden="true"></i></span>
        <h1 class="page-title mb-2">We couldn't find that</h1>
        <p class="text-muted mb-4">The record doesn't exist or isn't part of your caseload.</p>
        <a href="/" class="btn btn-primary"><i class="ri-home-4-line me-1" aria-hidden="true"></i>Back to dashboard</a>
    </div>
</div>
