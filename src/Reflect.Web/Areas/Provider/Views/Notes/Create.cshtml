@model Reflect.Web.Models.ViewModels.Provider.AddNote.AddNoteViewModel
@{
    ViewData["Title"] = "Add note";
    ViewData["ParentTitle"] = Model.PatientName;
    ViewData["ParentUrl"] = Url.Action("Details", "Patients", new { id = Model.PatientId, tab = "notes" });
}
@section Styles {
    <partial name="_ProviderStyles" />
}

<div class="mb-4">
    <h1 class="page-title mb-1">Add note</h1>
    <p class="text-muted fs-13 mb-0">@Model.PatientName · @Model.Mrn</p>
</div>

<div class="row">
    <div class="col-12 col-xl-8">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title"><i class="ri-sticky-note-add-line me-2" aria-hidden="true"></i>Note</div>
            </div>
            <div class="card-body">
                <form method="post" asp-action="Create" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="PatientId" />
                    <div class="row g-3">
                        <div class="col-12 col-md-5">
                            <label asp-for="NoteType" class="form-label"></label>
                            <select asp-for="NoteType" class="form-select" asp-items="Model.NoteTypeOptions">
                                <option value="">Choose a type</option>
                            </select>
                            <span asp-validation-for="NoteType" class="field-validation-error"></span>
                        </div>
                        <div class="col-12 col-md-7">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" maxlength="120" />
                            <span asp-validation-for="Title" class="field-validation-error"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Body" class="form-label"></label>
                            <textarea asp-for="Body" class="form-control" rows="8" maxlength="4000"></textarea>
                            <span asp-validation-for="Body" class="field-validation-error"></span>
                        </div>
                    </div>
                    <div class="rx-page-actions mt-4">
                        <button type="submit" class="btn btn-primary"><i class="ri-save-line me-1" aria-hidden="true"></i>Save note</button>
                        <a class="btn btn-outline-secondary" asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" asp-route-tab="notes">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
